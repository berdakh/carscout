# Required for the AI features (chat agent, listing parser). Everything else works without it.
ANTHROPIC_API_KEY=

# Model used by the agent and the listing parser.
CARSCOUT_MODEL=claude-opus-5-5

# Optional free-tier search keys. Leave both blank to use DuckDuckGo (no key, less reliable).
BRAVE_API_KEY=
TAVILY_API_KEY=

# Defaults used by the finance engine (override per request from the UI).
CARSCOUT_SALES_TAX_PCT=7.0
CARSCOUT_DOC_FEES=500
CARSCOUT_GAS_PRICE=3.40
CARSCOUT_MILES_PER_YEAR=12000
